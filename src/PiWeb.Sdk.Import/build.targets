<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <PropertyGroup>
    <!-- Whether to create a .pip package file when building -->
    <GeneratePluginPackageOnBuild Condition=" '$(GeneratePluginPackageOnBuild)' == '' ">false</GeneratePluginPackageOnBuild>

    <_PiWebImportPluginManifestPath>$(MSBuildProjectDirectory)\manifest.json</_PiWebImportPluginManifestPath>
    <_PiWebImportPluginManifestContent Condition="Exists('$(_PiWebImportPluginManifestPath)')">$([System.IO.File]::ReadAllText('$(_PiWebImportPluginManifestPath)'))</_PiWebImportPluginManifestContent>
    <_PiWebImportPluginVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_PiWebImportPluginManifestContent)', '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_PiWebImportPluginVersion>
    <_PiWebImportPluginVersion Condition="'$(_PiWebImportPluginVersion)' == ''">$(Version)</_PiWebImportPluginVersion>
  </PropertyGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="$(_PiWebImportPluginManifestPath)" />
    <UpToDateCheckOutput Include="$(PackageOutputPath)\$(AssemblyName)@$(_PiWebImportPluginVersion).pip" />
  </ItemGroup>
  
  <!-- Calls _GeneratePluginPackage after building when 'GeneratePluginPackageOnBuild' == true -->
  <Target Name="PackPluginAfterBuild"
          AfterTargets="Build"
          Condition=" '$(GeneratePluginPackageOnBuild)' == 'true' "
          DependsOnTargets="_GeneratePluginPackage">
  </Target>

  <!-- This target can be manually called to pack the project as .pip package file -->
  <Target Name="PackPlugin" 
          DependsOnTargets="Build;_GeneratePluginPackage">
  </Target>

  <!-- Creates a .pip package file for the project -->
  <Target Name="_GeneratePluginPackage" 
          DependsOnTargets="Build">

    <Warning Condition="$([MSBuild]::VersionNotEquals('$(_PiWebImportPluginVersion)', '$(Version)'))"
             Text="The plugin version in the manifest.json ($(_PiWebImportPluginVersion)) differs from the assembly version ($(Version))." />

    <ItemGroup>
      <PipFiles Exclude="$(OutDir)\*.pip" Include="$(OutDir)\**\*" />
    </ItemGroup>

    <Message Text="Removing previously created staging directory."
             Importance="low" />
    <RemoveDir Directories="$(IntermediateOutputPath)\PipStaging" />

    <Message Text="Copying build output to '$(IntermediateOutputPath)\PipStaging'."
             Importance="low" />
    <Copy SourceFiles="@(PipFiles)" DestinationFolder="$(IntermediateOutputPath)\PipStaging" />
    
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)\PipStaging"
                  DestinationFile="$(PackageOutputPath)\$(AssemblyName)@$(_PiWebImportPluginVersion).pip"
                  Overwrite="true" />
    
    <Message Text="Successfully created plugin package '$(PackageOutputPath)\$(AssemblyName)@$(_PiWebImportPluginVersion).pip'."
             Importance="high" />
             
  </Target>
  
</Project>